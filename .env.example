# Copy to .env, fill in the values you need, then: source .env
# Only the variable named by `api_key_env` in your config is actually read.
# Note: Task 4 judges default to OPENAI_API_KEY; the Task 4 generator uses
# whatever api_key_env names (DASHSCOPE_API_KEY in the sample config).

# OpenAI-compatible protocol (OpenAI, DashScope, vLLM, ...)
export OPENAI_API_KEY=""

# Anthropic protocol (https://api.anthropic.com)
export ANTHROPIC_API_KEY=""

# DashScope (Alibaba Cloud) compatible-mode endpoint
export DASHSCOPE_API_KEY=""
